# Optional direct-development overrides. `pnpm dev` defaults to port 3000 and
# isolated storage under data/development without this file.
# ARTIFACTS_PORT=3000
# ARTIFACTS_PUBLIC_BASE_URL=http://localhost:3000
# ARTIFACTS_FILES_DIR=./data/development/files
# ARTIFACTS_DATABASE_PATH=./data/development/database/artifacts.db
# ARTIFACTS_THUMBS_DIR=./data/development/thumbs
# Gallery previews need a Chromium. Common install locations are probed
# automatically; set this when yours is somewhere else.
# ARTIFACTS_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Turns on owner login when set; a blank value or one shorter than 16
# characters is refused. Leave unset for the no-auth, trusted-network mode.
# ARTIFACTS_OWNER_PASSWORD=
# With owner login behind a reverse proxy, the header the proxy sets to the
# client's address, so login attempts are limited per client. Name it only
# when the server is reachable through the proxy alone.
# ARTIFACTS_CLIENT_ADDRESS_HEADER=CF-Connecting-IP
