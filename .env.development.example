# Optional direct-development overrides. `pnpm dev` defaults to port 4243 and
# isolated storage under data/development without this file.
# MUNINN_PORT is the one setting to change to move Muninn. The public base URL
# follows it unless MUNINN_PUBLIC_BASE_URL is set.
# MUNINN_PORT=4243
# MUNINN_PUBLIC_BASE_URL=http://localhost:4243
# MUNINN_FILES_DIR=./data/development/files
# MUNINN_DATABASE_PATH=./data/development/database/artifacts.db
# MUNINN_THUMBS_DIR=./data/development/thumbs
# Gallery previews need a Chromium. Common install locations are probed
# automatically; set this when yours is somewhere else.
# MUNINN_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Turns on owner login when set; a blank value or one shorter than 16
# characters is refused. Leave unset for the no-auth, trusted-network mode.
# MUNINN_OWNER_PASSWORD=
# With owner login behind a reverse proxy, the header the proxy sets to the
# client's address, so login attempts are limited per client. Name it only
# when the server is reachable through the proxy alone.
# MUNINN_CLIENT_ADDRESS_HEADER=CF-Connecting-IP
