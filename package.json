{
  "name": "artifacts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,assets -c blue,magenta \"tsx watch src/server.ts\" \"vite build --watch\"",
    "build": "vp pack && vite build",
