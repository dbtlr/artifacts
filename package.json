    "@shikijs/themes": "^4.3.1",
    "hono": "^4.12.31",
    "markdown-it": "^14.3.0",
    "nanoid": "^6.0.0",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dbtlr/tooling": "^0.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.3",
    "mermaid": "^11.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vite-plus": "^0.2.1"
