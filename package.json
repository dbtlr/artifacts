{
  "name": "@dbtlr/artifacts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "cross-env NODE_ENV=development concurrently -n server,assets -c blue,magenta \"tsx watch --env-file-if-exists=.env.development src/server.ts\" \"vite build --watch\"",
    "build": "vp pack && vite build",
    "docker:check": "tsx --env-file-if-exists=.env scripts/docker.ts check",
    "docker:build": "tsx --env-file-if-exists=.env scripts/docker.ts build",
    "docker:start": "tsx --env-file-if-exists=.env scripts/docker.ts start",
    "docker:stop": "tsx --env-file-if-exists=.env scripts/docker.ts stop",
    "docker:logs": "tsx --env-file-if-exists=.env scripts/docker.ts logs",
    "start": "cross-env NODE_ENV=development node --env-file-if-exists=.env dist/server.js",
    "lint": "vp lint",
    "fmt": "vp fmt --check",
    "test": "vp test run"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "hono": "^4.13.3",
    "markdown-it": "^15.0.0",
    "nanoid": "^6.0.1",
    "shiki": "^4.4.3",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dbtlr/tooling": "^0.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "mermaid": "^11.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0",
    "vite": "^8.2.1",
    "vite-plus": "^0.2.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1"
}
