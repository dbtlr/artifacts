# Optional Docker/runtime overrides. The zero-configuration Docker path does
# not require this file; copy it to .env only when changing a default.
# MUNINN_PORT=4242
# MUNINN_PUBLIC_BASE_URL=http://localhost:4242
# MUNINN_FILES_MOUNT=artifacts-files
# MUNINN_DATABASE_MOUNT=artifacts-database
# MUNINN_THUMBS_MOUNT=artifacts-thumbs
# Turns on owner login when set; a blank value or one shorter than 16
# characters is refused. Leave unset for the no-auth, trusted-network mode.
# MUNINN_OWNER_PASSWORD=
# With owner login behind a reverse proxy, the header the proxy sets to the
# client's address, so login attempts are limited per client. Name it only
# when the server is reachable through the proxy alone.
# MUNINN_CLIENT_ADDRESS_HEADER=CF-Connecting-IP
